      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[1m])/clamp_min(rate(hikaricp_connections_acquire_seconds_count[1m]),1)",
