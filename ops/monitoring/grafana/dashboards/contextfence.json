{
  "uid": "contextfence-local",
  "title": "ContextFence · Local operations",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "contextfence",
    "local",
    "operations",
    "synthetic"
  ],
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "ContextFence · 本地运维 / Local operations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**先看就绪与备份，再检查请求、数据库和资源。** 指标来自 Prometheus；无数据不等于零或健康。\n\n**Start with readiness and backup age.** Then inspect traffic, database waits and resources. No data is not zero or healthy."
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "01 · 服务与请求 / Service & traffic",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "title": "服务就绪 · Readiness",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "contextfence_ready",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "无数据 / No data",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "未就绪 / Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "就绪 / Ready",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "0=未就绪，1=已就绪。没有数据不代表服务健康；检查 Prometheus scrape 与启动门禁。"
    },
    {
      "id": 12,
      "title": "备份新鲜度 · Snapshot age",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-contextfence_backup_snapshot_timestamp_seconds",
          "legendFormat": "Snapshot age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "无数据 / No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 4200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "距最近成功快照的秒数。4200 秒阈值沿用 BackupExpired 的 70 分钟规则；无数据也需检查。"
    },
    {
      "id": 2,
      "title": "请求速率 · Requests/s",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance,reason) (rate(http_server_requests_seconds_count{job=\"contextfence\",uri=~\"/v1/.*\"}[1m]))",
          "legendFormat": "{{instance}} · {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:requests/s",
          "decimals": 2,
          "noValue": "无数据 / No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "业务 /v1 请求的每秒速率，按实例与原因分组；保留原始 1 分钟 rate 窗口。"
    },
    {
      "id": 3,
      "title": "尾部延迟 · p99",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le,instance)(rate(http_server_requests_seconds_bucket{job=\"contextfence\",uri=~\"/v1/.*\"}[2m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "无数据 / No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "业务请求的 p99，按实例显示。容量告警采用冻结的实验阈值，此图不引入固定 SLO。"
    },
    {
      "id": 13,
      "title": "应用 CPU · Usage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"contextfence\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "无数据 / No data",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "按实例显示进程 CPU 的 0–1 指标；以百分比格式展示，查询不变。"
    },
    {
      "id": 102,
