# Reference only: scripts/start.py generates and preserves local secrets.
# Never replace an initialized .env with this placeholder.
POSTGRES_USER=contextfence
POSTGRES_DB=contextfence
POSTGRES_PASSWORD=replace-with-your-own-random-password
ENTRY_PORT=58090
PROMETHEUS_PORT=59090
GRAFANA_PORT=53000
OPS_PROJECT_NAME=contextfence
# start.py builds the SHA256-verified official Grafana archive and records its image ID.
# An explicit GRAFANA_IMAGE override must be sha256:... or repository@sha256:....
# API and PostgreSQL have no host ports. Credentials are .local/secrets files.
# DB_HOST is managed in .local/runtime/database.env during isolated recovery.
